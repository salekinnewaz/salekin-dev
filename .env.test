# Test environment.
#
# DATABASE_URL is an ABSOLUTE path on purpose. Prisma resolves a
# relative `file:` URL against the directory of the schema file
# (prisma/), while Next.js resolves it against the project root —
# so `file:./test.db` points at prisma/test.db for `prisma db push`
# but at ./test.db for `next build`. The two land in different files
# and the build dies with "The table `main.Setting` does not exist".
#
# An absolute path is resolved identically from any working
# directory, so the CLI and the build always open the same file.
DATABASE_URL="file:/tmp/salekin-dev-test.db"
NODE_ENV="test"
