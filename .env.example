# Local development: file-backed SQLite at <repo>/prisma/dev.db.
DATABASE_URL="file:./dev.db"

# "development" | "production" | "test". Vercel sets production automatically.
NODE_ENV="development"

# Used by OpenGraph + canonical URLs. Set this in prod or social cards break.
# SITE_URL="https://salekin.dev"

# Set BOTH of these in production before exposing /admin.
# ADMIN_PASSWORD       → password you'll type at /admin/login (>= 1 char).
# ADMIN_SESSION_SECRET → HMAC key for the session cookie, >= 16 chars.
# Generate a secret with: openssl rand -base64 48
# ADMIN_PASSWORD=""
# ADMIN_SESSION_SECRET=""

# Production-only (see DEPLOY.md §2): libSQL URL + token for Turso.
# The code in this repo does not yet wire the @prisma/adapter-libsql client;
# DEPLOY.md step 2 walks through the swap.
# TURSO_DATABASE_URL="libsql://<db>.<org>.turso.io"
# TURSO_AUTH_TOKEN=""